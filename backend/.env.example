# ===== Server =====
NODE_ENV=development
PORT=5000

# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/company_profile?schema=public"

# ===== Auth =====
# Gunakan string acak panjang (min. 32 karakter). Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=5ca100ce80dada7effa155890f70feabca8dcb4f94d907f2463d0bf89c17f9e592759d511726f9851b9e23ed24845cc8

JWT_EXPIRES_IN=7d
COOKIE_NAME=cp_token
# Set true jika dijalankan di balik HTTPS (production)
COOKIE_SECURE=false
# Jika frontend & backend beda domain di production, gunakan: none (wajib COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ===== CORS (pisahkan dengan koma) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL publik backend (dipakai membentuk URL gambar upload lokal)
PUBLIC_API_URL=http://localhost:5000

# ===== Seed admin default =====
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# ===== Upload gambar =====
# Kosongkan semua CLOUDINARY_* untuk menyimpan di folder lokal ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5

# ===== Rate limit =====
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
